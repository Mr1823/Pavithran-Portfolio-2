{
  "name": "has-tostringtag",
  "version": "1.0.2",
  "description": "Determine if the JS environment has `Symbol.toStringTag` support. Supports spec, or shams.",
  "license": "MIT",
  "author": "Jordan Harband <ljharb@gmail.com> (http://ljharb.codes)",
  "contributors": [
    "Jordan Harband <ljharb@gmail.com> (http://ljharb.codes)"
  ],
  "homepage": "https://github.com/inspect-js/has-tostringtag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspect-js/has-tostringtag.git"
  },
  "bugs": {
    "url": "https://github.com/inspect-js/has-tostringtag/issues"
  },
  "exports": {
    ".": [
      {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "./index.js"
    ],
    "./shams": [
      {
        "types": "./shams.d.ts",
        "default": "./shams.js"
      },
      "./shams.js"
    ],
    "./package.json": "./package.json"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint --ext=js,mjs .",
    "prepack": "npmignore --auto --commentLines=autogenerated",
    "prepublishOnly": "safe-publish-latest",
    "prepublish": "not-in-publish || npm run prepublishOnly",
    "pretest": "npm run --silent lint",
    "test": "npm run tests-only",
    "posttest": "aud --production",
    "test:shams": "npm run --silent test:shams:getownpropertysymbols && npm run --silent test:shams:corejs",
    "test:shams:corejs": "nyc node test/shams/core-js.js",
    "test:shams:getownpropertysymbols": "nyc node test/shams/get-own-property-symbols.js",
    "test:staging": "nyc node --harmony --es-staging test",
    "test:stock": "nyc node test",
    "tests-only": "npm run test:stock && npm run test:shams",
    "version": "auto-changelog && git add CHANGELOG.md",
    "postversion": "auto-changelog && git add CHANGELOG.md && git commit --no-edit --amend && git tag -f \"v$(node -e \"console.log(require('./package.json').version)\")\""
  },
  "types": "./index.d.ts",
  "dependencies": {
    "has-symbols": "^1.0.3"
  },
  "devDependencies": {
    "@ljharb/eslint-config": "^21.1.0",
    "@types/has-symbols": "^1.0.2",
    "@types/tape": "^5.6.4",
    "aud": "^2.0.4",
    "auto-changelog": "^2.4.0",
    "core-js": "^2.6.12",
    "eslint": "=8.8.0",
    "get-own-property-symbols": "^0.9.5",
    "in-publish": "^2.0.1",
    "npmignore": "^0.3.1",
    "nyc": "^10.3.2",
    "safe-publish-latest": "^2.0.0",
    "tape": "^5.7.4",
    "typescript": "next"
  },
  "keywords": [
    "Symbol.toStringTag",
    "ecmascript",
    "javascript",
    "symbol",
    "symbols",
    "tostringtag"
  ],
  "engines": {
    "node": ">= 0.4"
  },
  "publishConfig": {
    "ignore": [
      ".github/workflows"
    ]
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": false,
    "commitLimit": false,
    "backfillLimit": false,
    "hideCredit": true
  },
  "funding": {
    "url": "https://github.com/sponsors/ljharb"
  }
}
